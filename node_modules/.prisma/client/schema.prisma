// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  states    State[]
}

model State {
  id        Int        @id @default(autoincrement())
  name      String
  code      String     @unique
  countryId Int
  country   Country    @relation(fields: [countryId], references: [id])
  createdAt DateTime   @default(now())
  districts District[]

  @@index([countryId])
  @@index([name])
}

model District {
  id           Int           @id @default(autoincrement())
  name         String
  code         String        @unique
  stateId      Int
  state        State         @relation(fields: [stateId], references: [id])
  createdAt    DateTime      @default(now())
  subDistricts SubDistrict[]

  @@index([stateId])
  @@index([name])
}

model SubDistrict {
  id         Int       @id @default(autoincrement())
  name       String
  code       String    @unique
  districtId Int
  district   District  @relation(fields: [districtId], references: [id])
  createdAt  DateTime  @default(now())
  villages   Village[]

  @@index([districtId])
  @@index([name])
}

model Village {
  id            Int         @id @default(autoincrement())
  name          String
  code          String      @unique
  subDistrictId Int
  subDistrict   SubDistrict @relation(fields: [subDistrictId], references: [id])
  createdAt     DateTime    @default(now())

  @@index([subDistrictId])
  @@index([name])
}

// New models for authentication and user management
enum Plan {
  FREE
  PREMIUM
  PRO
  UNLIMITED
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

model User {
  id                  Int        @id @default(autoincrement())
  businessName        String
  email               String     @unique
  phone               String?
  gst                 String?
  passwordHash        String // bcrypt hash
  role                UserRole   @default(USER)
  plan                Plan       @default(FREE)
  status              UserStatus @default(PENDING_APPROVAL)
  emailVerified       Boolean    @default(false)
  dailyLimit          Int        @default(5000) // requests per day
  stateAccess         Json? // array of state IDs, null = all access
  twoFactorEnabled    Boolean    @default(false)
  twoFactorSecret     String?
  twoFactorTempSecret String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  apiKeys             ApiKey[]
  usages              Usage[]

  @@index([email])
  @@index([status])
  @@index([role])
}

model ApiKey {
  id          Int          @id @default(autoincrement())
  fingerprint String       @unique
  secretHash  String // bcrypt hash
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  status      ApiKeyStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  usages      Usage[]

  @@index([userId])
  @@index([fingerprint])
}

model Usage {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  apiKeyId     Int?
  apiKey       ApiKey?  @relation(fields: [apiKeyId], references: [id])
  endpoint     String
  method       String // GET, POST, etc.
  statusCode   Int
  responseTime Int // ms
  date         DateTime @default(now())

  @@index([userId])
  @@index([apiKeyId])
  @@index([date])
}
