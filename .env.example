# Local development environment variables
DATABASE_URL=postgresql://user:password@localhost:5432/bluestock
JWT_SECRET=replace-with-secure-secret
FRONTEND_URL=http://localhost:5173

# Redis / cache (Upstash recommended for serverless)
UPSTASH_REDIS_REST_URL=https://<your-upstash-url>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>

# SMTP email delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
EMAIL_FROM=noreply@bluestock.com

# Initial admin bootstrap account
ADMIN_EMAIL=admin@bluestock.com
ADMIN_PASSWORD=supersecretpassword
ADMIN_BUSINESS_NAME=Bluestock Admin
ADMIN_PHONE=1234567890
ADMIN_GST=GST1234567

# Demo API key restrictions
DEMO_API_KEY=ak_demo000000000000000000000000000000
DEMO_STATE_NAME=Maharashtra
